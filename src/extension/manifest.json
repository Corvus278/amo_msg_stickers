{
  "manifest_version": 3,
  "name": "amo stickers",
  "version": "0.13.0",
  "description": "__MSG_extDescription__",
  "default_locale": "ru",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.giphy.com/*",
    "https://*.giphy.com/*",
    "https://api.klipy.com/*",
    "https://*.klipy.com/*",
    "https://api.telegram.org/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.amo.tm/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
